# ─── Cocktail Embassy · переменные окружения ───────────────────────────────
# Никаких токенов и ключей в коде: всё задаётся здесь или в панели хостинга.

# Бот (обязательно для Telegram-части)
BOT_TOKEN=
ADMIN_IDS=                      # ID администраторов через запятую (узнать: @userinfobot)
BOT_USERNAME=                   # имя бота без @ — для ссылок возврата после оплаты

# Адрес приложения (для кнопки Mini App, ссылок на инвойсы и вебхука)
PUBLIC_URL=                     # https://ваш-домен (без слэша на конце)

# Сеть
PORT=3000
HOST=0.0.0.0
EXTRA_PORTS=3000,8080
MODE=all                        # all | web | bot
DEFAULT_LOCALE=ru               # язык по умолчанию: ru | en

# Магазин
CURRENCY=AED
USD_RATE=3.6725                 # курс для справочной цены в USD (1 USD = N AED)
FREE_SHIPPING_FROM=1000         # бесплатная доставка от суммы, AED
SHIPPING_COST=50                # стоимость доставки по эмиратам, AED
MIN_ORDER_TOTAL=0
WHOLESALE_FROM=24               # от какого количества считаем мелкий опт

# Реквизиты продавца для инвойса (ОАЭ)
SELLER_NAME=Cocktail Embassy
SELLER_LEGAL_NAME=Cocktail Embassy FZ-LLC
SELLER_TRN=                     # Tax Registration Number (VAT)
SELLER_LICENCE=                 # номер торговой лицензии
SELLER_ADDRESS=Al Quoz Industrial Area 3, Dubai, UAE
SELLER_BANK_NAME=
SELLER_ACCOUNT_NAME=Cocktail Embassy FZ-LLC
SELLER_IBAN=
SELLER_SWIFT=
SELLER_ACCOUNT_NUMBER=
SELLER_PHONE=+971 56 238 8262
SELLER_EMAIL=sales@cocktailembassy.ae
INVOICE_PREFIX=CE-
VAT_RATE=5                      # НДС ОАЭ
VAT_INCLUDED=1                  # 1 — НДС уже в цене, 0 — начисляется сверху

# Оплата картой (необязательно)
PAYMENT_LINK=                   # постоянная платёжная ссылка (Stripe/PayBy/Telr)
PAYMENT_NOTE=                   # текст для клиента на экране оплаты
YOOKASSA_SHOP_ID=               # если подключаете ЮKassa
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
YOOKASSA_RECEIPT=0

# Telegram: long polling по умолчанию, вебхук — TELEGRAM_MODE=webhook
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
